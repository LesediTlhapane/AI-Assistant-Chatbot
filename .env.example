# # Groq API Key (Server-side only, NEVER expose to client browser)
# GROQ_API_KEY=your_groq_api_key_here

# # Groq Model Identifier (Default: llama-3.3-70b-versatile, or llama-3.1-8b-instant, openai/gpt-oss-20b)
# GROQ_MODEL="llama-3.3-70b-versatile"

# # Server Port (Default: 3000 for fullstack / 3001 for standalone API)
# PORT=3000

# # Allowed Origins for CORS and postMessage (Comma-separated)
# ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:5173,https://estudy.co.za"
